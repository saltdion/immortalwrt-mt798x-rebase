# AX6000 25.12 厂商无线驱动精简配置；设备目标由脚本统一收敛。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y

# 保留厂商无线及加速管理；精简上游额外应用和重复主题。
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set
# CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
CONFIG_PACKAGE_luci-theme-bootstrap-mod=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_dae is not set

# ========== OpenClash 底层依赖（固件内置，后续网页安装OpenClash本体） ==========
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_luci-compat=y

# ========== OpenClash 依赖内核模块 ==========
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ========== DAE 完整BPF内核选项（由官方文档转换为ImmortalWrt格式） ==========
# https://github.com/daeuniverse/dae/blob/main/docs/zh/README.md
# daed Makefile 注释要求: You need enable KERNEL_DEBUG_INFO_BTF and KERNEL_BPF_EVENTS
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_NET_INGRESS=y
CONFIG_KERNEL_NET_EGRESS=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_BPFSTREAM=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
# [FIX] 显式启用 XDP sockets 支持
# kmod-xdp-sockets-diag 的 DEPENDS:= @KERNEL_XDP_SOCKETS
# KERNEL_XDP_SOCKETS 默认仅在 KERNEL_DEBUG_INFO_BTF 开启时自动启用
# 显式设置确保不受 BTF 状态影响
CONFIG_KERNEL_XDP_SOCKETS=y

# ========== DAE 需要编译为模块的包（原生=m 对应 OpenWrt kmod包） ==========
# daed 运行时 kmod 依赖（来自 daed Makefile DEPENDS）:
#   +kmod-sched-core +kmod-sched-bpf +kmod-xdp-sockets-diag +kmod-veth
# 这些 kmod 包是内核版本绑定的，必须编译进固件，opkg 无法从在线仓库安装
# daed/daed-geoip/daed-geosite/luci-app-daed 不编译进固件，后期 opkg 按需安装/卸载
# [FIX] 补充缺失的 kmod-sched-core（kmod-sched-bpf 不会自动拉取它）
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-ingress=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# ========== 插件选择 ==========
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-arpbind=y

# 全部移除Passwall，不内置OpenClash本体
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-msd_lite is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# ========== LuCI语言：保留简体中文 + 英文，其余全部关闭 ==========
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_LUCI_LANG_en=y
# CONFIG_LUCI_LANG_zh-tw is not set
# CONFIG_LUCI_LANG_ja is not set
# CONFIG_LUCI_LANG_ru is not set
# CONFIG_LUCI_LANG_de is not set
# CONFIG_LUCI_LANG_fr is not set
# CONFIG_LUCI_LANG_es is not set
# CONFIG_LUCI_LANG_pt is not set
# CONFIG_LUCI_LANG_pl is not set
# CONFIG_LUCI_LANG_ko is not set
# CONFIG_LUCI_LANG_it is not set
# CONFIG_LUCI_LANG_cs is not set
# CONFIG_LUCI_LANG_hu is not set
# CONFIG_LUCI_LANG_tr is not set
# CONFIG_LUCI_LANG_vi is not set

# ========== 编译体积优化选项 ==========
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_PACKAGE_man is not set
# CONFIG_PACKAGE_doc is not set

# ========== 工具包：保留 curl wget，去掉nano、vim-full ==========
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_vim-full is not set
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_perl is not set
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# ========== 关闭USB全套驱动（AX6000无USB硬件） ==========
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-audio is not set

# ========== 关闭蓝牙 ==========
# CONFIG_PACKAGE_kmod-bluetooth is not set

# ========== 关闭不使用的文件系统驱动 ==========
# CONFIG_PACKAGE_kmod-fs-cifs is not set
# CONFIG_PACKAGE_kmod-fs-nfs is not set
# CONFIG_PACKAGE_kmod-fs-fuse is not set
